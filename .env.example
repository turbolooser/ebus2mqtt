# ebus2mqtt — copy to .env and fill in. Never commit the real .env.
EBUS_DEVICE=ens:192.0.2.10:9999
# 31 while another master (e.g. a WCM-COM, address ff) is on the bus; ff only after it is disconnected
EBUS_ADRESSE=31
MQTT_HOST=192.0.2.20
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=wcm
HA_DISCOVERY_PREFIX=homeassistant
# KUMA_PUSH_URL=
